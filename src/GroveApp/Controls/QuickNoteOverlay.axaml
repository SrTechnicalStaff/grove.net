<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ds="clr-namespace:GroveApp.DesignSystem"
             x:Class="GroveApp.Controls.QuickNoteOverlay"
             Background="Transparent">

    <!-- Quick Note captures a new placement; FluentNotepadEditor edits an existing one. -->
    <Border Name="FrameBorder"
            Width="{x:Static ds:Tokens.QuickNoteFrameWidth}"
            MaxWidth="{x:Static ds:Tokens.QuickNoteFrameWidth}"
            MinHeight="{x:Static ds:Tokens.QuickNoteMinHeight}"
            MaxHeight="{x:Static ds:Tokens.QuickNoteMaxHeight}"
            Background="{x:Static ds:Colors.SurfaceChromeHex}"
            BorderBrush="{x:Static ds:Colors.KSlateBorderHex}"
            BorderThickness="1"
            CornerRadius="{x:Static ds:Tokens.CornerRadiusSm}"
            Padding="{x:Static ds:Tokens.ThicknessLg}"
            BoxShadow="{x:Static ds:Tokens.ShadowLocal}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

        <StackPanel Spacing="{x:Static ds:Tokens.SpaceMd}">
            <Grid ColumnDefinitions="*,Auto" Margin="{x:Static ds:Tokens.QuickNoteIdentityMargin}">
                <TextBlock Grid.Column="0"
                           Text="QUICK NOTE"
                           FontFamily="{x:Static ds:Typography.FontFamilyDisplay}"
                           FontSize="{x:Static ds:Typography.SizeTitleSmall}"
                           FontWeight="{x:Static ds:Typography.WeightDisplay}"
                           Foreground="{x:Static ds:Colors.CSlateBrush}"
                           LetterSpacing="{x:Static ds:Typography.TrackingLabel}" />
                <Button Name="BtnHeaderClose"
                        Grid.Column="1"
                        Click="BtnHeaderClose_Click"
                        Background="Transparent"
                        BorderBrush="{x:Static ds:Colors.EdgeFoundBrush}"
                        BorderThickness="1"
                        CornerRadius="{x:Static ds:Tokens.CornerRadiusSm}"
                        Foreground="{x:Static ds:Colors.TextSecondaryBrush}"
                        FontFamily="{x:Static ds:Typography.FontFamilyUi}"
                        FontSize="{x:Static ds:Typography.SizeCaption}"
                        Padding="{x:Static ds:Tokens.QuickNoteHeaderPadding}">Close</Button>
            </Grid>

            <Border Name="CaptureFieldBorder"
                    Background="{x:Static ds:Colors.SurfaceNestedHex}"
                    BorderBrush="{x:Static ds:Colors.EdgeQuietBrush}"
                    BorderThickness="1"
                    CornerRadius="{x:Static ds:Tokens.CornerRadiusSm}"
                    Padding="{x:Static ds:Tokens.ThicknessMd}">
                <TextBox Name="TxtCapture"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="{x:Static ds:Tokens.QuickNoteCaptureMinHeight}"
                         MaxHeight="{x:Static ds:Tokens.QuickNoteCaptureMaxHeight}"
                         Background="Transparent"
                         Foreground="{x:Static ds:Colors.TextPrimaryBrush}"
                         CaretBrush="{x:Static ds:Colors.SignalInteractionBrush}"
                         BorderThickness="0"
                         CornerRadius="0"
                         Padding="0"
                         FontFamily="{x:Static ds:Typography.FontFamilyUi}"
                         FontSize="{x:Static ds:Typography.SizeLead}"
                         HorizontalAlignment="Stretch"
                         TextOptions.TextRenderingMode="SubpixelAntialias" />
            </Border>

            <StackPanel Name="HintLine" Orientation="Horizontal" Spacing="{x:Static ds:Tokens.SpacingMd}">
                <TextBlock Text="ENTER  line break"
                           FontFamily="{x:Static ds:Typography.FontFamilyMono}"
                           FontSize="{x:Static ds:Typography.SizeLabel}"
                           Foreground="{x:Static ds:Colors.TextMetaBrush}" />
                <TextBlock Text="•" Foreground="{x:Static ds:Colors.TextMetaBrush}" />
                <TextBlock Text="SHIFT+ENTER  save &amp; next Note"
                           FontFamily="{x:Static ds:Typography.FontFamilyMono}"
                           FontSize="{x:Static ds:Typography.SizeLabel}"
                           Foreground="{x:Static ds:Colors.TextMetaBrush}" />
                <TextBlock Text="•" Foreground="{x:Static ds:Colors.TextMetaBrush}" />
                <TextBlock Text="CTRL+ENTER  save &amp; place"
                           FontFamily="{x:Static ds:Typography.FontFamilyMono}"
                           FontSize="{x:Static ds:Typography.SizeLabel}"
                           Foreground="{x:Static ds:Colors.TextMetaBrush}" />
            </StackPanel>

            <StackPanel Name="FeedContainer"
                        Spacing="{x:Static ds:Tokens.SpaceSm}"
                        IsVisible="False" />
        </StackPanel>
    </Border>
</UserControl>
