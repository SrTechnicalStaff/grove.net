<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GroveApp.Controls"
             xmlns:ds="clr-namespace:GroveApp.DesignSystem"
             x:Class="GroveApp.Controls.GallerySlateControl"
             AutomationProperties.AutomationId="GallerySlate"
             AutomationProperties.Name="Gallery"
             IsVisible="False"
             IsHitTestVisible="True"
             Focusable="True"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="{x:Static ds:Colors.SurfaceGridHex}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <controls:MasonryGalleryPanel x:Name="GalleryWall" />
    </ScrollViewer>
</UserControl>
