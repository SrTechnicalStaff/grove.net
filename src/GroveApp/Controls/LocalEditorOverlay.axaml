<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ds="clr-namespace:GroveApp.DesignSystem"
             xmlns:controls="clr-namespace:GroveApp.Controls"
             x:Class="GroveApp.Controls.LocalEditorOverlay">

    <Border Name="FrameBorder"
            Width="580"
            MinHeight="340"
            MaxHeight="440"
            Background="{x:Static ds:Colors.SurfaceChromeHex}"
            BorderBrush="{x:Static ds:Colors.EdgeQuietBrush}"
            BorderThickness="1"
            CornerRadius="{x:Static ds:Tokens.CornerRadiusSm}"
            Padding="0"
            BoxShadow="0 8 24 0 #66000000">

        <Grid RowDefinitions="Auto, *, Auto">

            <!-- ROW 0: WINDOWS 11 NOTEPAD TAB STRIP & TOOLBAR HEADER -->
            <Border Grid.Row="0"
                    Height="40"
                    Background="#111113"
                    BorderBrush="#242428"
                    BorderThickness="0,0,0,1"
                    Padding="8,0">
                <Grid ColumnDefinitions="*, Auto">
                    <!-- Tab Strip Header (Left side) -->
                    <ScrollViewer Grid.Column="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center">
                        <StackPanel Name="TabStripPanel"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center" />
                    </ScrollViewer>

                    <!-- Header Right Controls: Mode Toggle & Unsaved Status -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center"
                                Margin="8,0,4,0">

                        <TextBlock Name="TxtUnsavedBadge"
                                   Text="• Unsaved"
                                   FontFamily="{x:Static ds:Typography.FontFamilyMono}"
                                   FontSize="{x:Static ds:Typography.SizeLabel}"
                                   Foreground="{x:Static ds:Colors.KEditBrush}"
                                   VerticalAlignment="Center"
                                   IsVisible="False" />

                        <!-- WYSIWYG / RAW Toggle Button -->
                        <Button Name="BtnModeToggle"
                                Click="BtnModeToggle_Click"
                                Background="#242428"
                                BorderBrush="#3A3A40"
                                BorderThickness="1"
                                CornerRadius="{x:Static ds:Tokens.CornerRadiusSm}"
                                Padding="10,4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Name="TxtModeLabel"
                                           Text="WYSIWYG"
                                           FontFamily="{x:Static ds:Typography.FontFamilyMono}"
                                           FontSize="{x:Static ds:Typography.SizeLabel}"
                                           FontWeight="SemiBold"
                                           Foreground="#EAEAEA" />
                                <TextBlock Text="[Ctrl+E]"
                                           FontFamily="{x:Static ds:Typography.FontFamilyMono}"
                                           FontSize="9"
                                           Foreground="{x:Static ds:Colors.TextMetaBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 1: EDITING SURFACE (RAW TEXTBOX vs WYSIWYG PREVIEW) -->
            <Grid Grid.Row="1" Margin="0">
                <!-- RAW Mode Draft Text Editor -->
                <TextBox Name="TxtDraft"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Background="Transparent"
                         Foreground="#EAEAEA"
                         CaretBrush="#EAEAEA"
                         BorderThickness="0"
                         CornerRadius="0"
                         Padding="16"
                         FontFamily="{x:Static ds:Typography.FontFamilyUi}"
                         FontSize="{x:Static ds:Typography.SizeBody}"
                         IsVisible="False" />

                <!-- WYSIWYG Formatted Live Preview -->
                <ScrollViewer Name="WysiwygScrollViewer"
                              Padding="16"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="True">
                    <controls:RichTextPreviewControl Name="WysiwygPreview" HorizontalAlignment="Stretch" VerticalAlignment="Top" MinHeight="200" />
                </ScrollViewer>

                <!-- Inline Confirm Row (Discard Unsaved Changes) -->
                <Border Name="InlineConfirmRow"
                        IsVisible="False"
                        VerticalAlignment="Bottom"
                        Background="#1C1C20"
                        BorderBrush="{x:Static ds:Colors.EdgeHairlineBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <TextBlock Grid.Column="0"
                                   Text="Discard unsaved changes for active note?"
                                   FontFamily="{x:Static ds:Typography.FontFamilyUi}"
                                   FontSize="{x:Static ds:Typography.SizeCaption}"
                                   Foreground="{x:Static ds:Colors.TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Name="BtnKeepEditing"
                                Grid.Column="1"
                                Click="BtnKeepEditing_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{x:Static ds:Colors.TextSecondaryBrush}"
                                FontSize="{x:Static ds:Typography.SizeCaption}"
                                Margin="0,0,12,0"
                                Padding="0">Keep editing</Button>
                        <Button Name="BtnDiscardConfirm"
                                Grid.Column="2"
                                Click="BtnDiscardConfirm_Click"
                                Background="{x:Static ds:Colors.SignalRefusalBrush}"
                                BorderThickness="0"
                                CornerRadius="{x:Static ds:Tokens.CornerRadiusSm}"
                                Foreground="#FFFFFF"
                                FontSize="{x:Static ds:Typography.SizeCaption}"
                                Padding="10,4">Discard</Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 2: CLEAN FOOTER -->
            <Border Grid.Row="2"
                    Height="44"
                    Background="#111113"
                    BorderBrush="#242428"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Escalation Route -->
                    <Button Name="BtnEscalate"
                            Grid.Column="0"
                            Click="BtnEscalate_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{x:Static ds:Colors.TextMetaBrush}"
                            FontFamily="{x:Static ds:Typography.FontFamilyUi}"
                            FontSize="{x:Static ds:Typography.SizeCaption}"
                            Padding="0"
                            VerticalAlignment="Center">Open in Writing Slate</Button>

                    <!-- Action Group: Cancel & Save -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Name="BtnCancel"
                                Click="BtnCancel_Click"
                                Background="Transparent"
                                BorderBrush="#3A3A40"
                                BorderThickness="1"
                                Foreground="#EAEAEA"
                                FontFamily="{x:Static ds:Typography.FontFamilyUi}"
                                FontSize="{x:Static ds:Typography.SizeCaption}"
                                CornerRadius="{x:Static ds:Tokens.CornerRadiusSm}"
                                Padding="12,5">Cancel (Esc)</Button>

                        <Button Name="BtnSave"
                                Click="BtnSave_Click"
                                FontFamily="{x:Static ds:Typography.FontFamilyUi}"
                                FontSize="{x:Static ds:Typography.SizeCaption}"
                                FontWeight="SemiBold"
                                CornerRadius="{x:Static ds:Tokens.CornerRadiusSm}"
                                Padding="16,5">Save (Ctrl+Enter)</Button>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
