<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GroveApp.Controls"
        xmlns:ds="clr-namespace:GroveApp.DesignSystem"
        x:Class="GroveApp.MainWindow"
        Title="Grove v9 — Spatial Grid Desktop Engine"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{x:Static ds:Colors.SurfaceGridHex}">

    <Grid>
        <!-- PLANE 0: Infinite Spatial Grid Canvas -->
        <controls:GridCanvasControl x:Name="CanvasControl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- PLANE 1: Floating In-Place Text Editor Overlay (Shown on Note Double-Click) -->
        <Border Name="EditorOverlay" IsVisible="False"
                Background="{x:Static ds:Colors.SurfaceChromeHex}"
                BorderBrush="{x:Static ds:Colors.SignalInteractionHex}"
                BorderThickness="2"
                CornerRadius="{x:Static ds:Tokens.CornerRadiusSm}"
                Padding="14"
                BoxShadow="0 8 24 #A0000000"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <StackPanel Spacing="10">
                <TextBlock Text="EDIT NOTE IN PLACE"
                           FontFamily="{x:Static ds:Typography.FontFamilyMono}"
                           FontSize="{x:Static ds:Typography.SizeLabel}"
                           FontWeight="Medium"
                           Foreground="{x:Static ds:Colors.SignalInteractionHex}"
                           LetterSpacing="1.2" />

                <TextBox Name="TxtEditor" Width="300" Height="110"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Background="{x:Static ds:Colors.SurfaceGridHex}"
                         Foreground="{x:Static ds:Colors.NoteTextHex}"
                         BorderBrush="{x:Static ds:Colors.HudSlateBorderHex}"
                         BorderThickness="1"
                         FontFamily="{x:Static ds:Typography.FontFamilyUi}"
                         FontSize="{x:Static ds:Typography.SizeBody}"
                         Padding="10"
                         CornerRadius="{x:Static ds:Tokens.CornerRadiusSm}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Name="BtnCancelEdit" Click="BtnCancelEdit_Click"
                            Background="{x:Static ds:Colors.SurfaceChromeHex}"
                            Foreground="{x:Static ds:Colors.NoteTextHex}"
                            BorderBrush="{x:Static ds:Colors.HudSlateBorderHex}"
                            BorderThickness="1"
                            CornerRadius="{x:Static ds:Tokens.CornerRadiusSm}"
                            Padding="10,4">Cancel</Button>

                    <Button Name="BtnSaveEdit" Click="BtnSaveEdit_Click"
                            Background="{x:Static ds:Colors.SignalInteractionHex}"
                            Foreground="#0E0E10"
                            CornerRadius="{x:Static ds:Tokens.CornerRadiusSm}"
                            Padding="12,4"
                            FontWeight="SemiBold">Commit (Ctrl+Enter)</Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Minimal Grid Telemetry Strip at Bottom -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="28"
                Background="{x:Static ds:Colors.SurfaceChromeHex}"
                BorderBrush="{x:Static ds:Colors.GridMajorLineHex}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto, *, Auto" Margin="14,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <TextBlock Name="TxtCellCoord" Text="CELL: (0, 0)"
                               Foreground="{x:Static ds:Colors.TextSecondaryBrush}"
                               FontSize="{x:Static ds:Typography.SizeLabel}"
                               FontFamily="{x:Static ds:Typography.FontFamilyMono}"
                               LetterSpacing="0.8" />
                    <TextBlock Name="TxtZoom" Text="ZOOM: 100%"
                               Foreground="{x:Static ds:Colors.TextSecondaryBrush}"
                               FontSize="{x:Static ds:Typography.SizeLabel}"
                               FontFamily="{x:Static ds:Typography.FontFamilyMono}"
                               LetterSpacing="0.8" />
                    <TextBlock Name="TxtNoteCount" Text="NOTES: 3"
                               Foreground="{x:Static ds:Colors.TextSecondaryBrush}"
                               FontSize="{x:Static ds:Typography.SizeLabel}"
                               FontFamily="{x:Static ds:Typography.FontFamilyMono}"
                               LetterSpacing="0.8" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="Middle / Right Click Drag to Pan • Wheel: Zoom • Double Click Cell: Add/Edit Note • Keys 2-4: Colors • A: Anchor • Del: Delete"
                           Foreground="{x:Static ds:Colors.TextSecondaryBrush}"
                           FontSize="{x:Static ds:Typography.SizeLabel}"
                           VerticalAlignment="Center"
                           FontFamily="{x:Static ds:Typography.FontFamilyUi}" />
            </Grid>
        </Border>
    </Grid>
</Window>
