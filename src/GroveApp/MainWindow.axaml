<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GroveApp.Controls"
        xmlns:ds="clr-namespace:GroveApp.DesignSystem"
        x:Class="GroveApp.MainWindow"
        Title="Grove"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{x:Static ds:Colors.SurfaceGridHex}">

    <controls:ThreePlaneVisualCompositorContainer x:Name="PlaneCompositor">
        <!-- PLANE 0: Infinite Spatial Grid Canvas -->
        <ContentControl x:Name="CanvasHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- PLANE 1: Information Plane Overlays -->
        <!-- Headerless Fluent Notepad Editor (Plane 1 Information Plane) -->
        <controls:FluentNotepadEditor x:Name="NotepadEditor" IsVisible="False" VerticalAlignment="Top" Background="Transparent" />

        <!-- Headerless Quick Note capture overlay (Plane 1 Information Plane) -->
        <controls:QuickNoteOverlay x:Name="QuickNote" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" />
        <controls:DocumentEditorOverlay x:Name="DocumentEditor" IsVisible="False" Background="Transparent" />
        <controls:ImagePropertyOverlay x:Name="ImageProperties" IsVisible="False" Background="Transparent" />

        <!-- PLANE 2: HUD Plane -->
        <!-- Spatial Layer Manager overlay (Plane 2 HUD) -->
        <controls:LayerManagerOverlay x:Name="LayerManagerOverlay" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,16,0" />

        <!-- Spatial context menu (Plane 2 HUD; opened from Plane 0 right-click) -->
        <controls:SpatialContextMenuOverlay x:Name="ContextMenuOverlay" />

        <!-- Active spatial identity and camera watermark (Plane 2 HUD) -->
        <controls:HudSpatialWatermark x:Name="SpatialWatermark" />

        <!-- Compact, collapsible performance tracker on the HUD plane. -->
        <controls:HudPerformanceTracker x:Name="PerformanceTracker"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="16" />

        <controls:WritingSlateControl x:Name="WritingSlate" />
        <controls:GallerySlateControl x:Name="GallerySlate" />
        <controls:MemorySlateControl x:Name="MemorySlate" />
    </controls:ThreePlaneVisualCompositorContainer>
</Window>
